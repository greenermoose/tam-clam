#!/bin/sh
# Demo 0.1.3: POSIX shell options (set -e, set -u, set -o pipefail,
# set -x with PS4 & LINENO, set -C / >|, set -n syntax checking).
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
SH="$ROOT/build/tam-clam"
[ -x "$SH" ] || make -C "$ROOT"

echo "--- 0.1.3: POSIX shell options ---"
"$SH" <<'SCRIPT'
echo "=== 1. set -e (errexit) & POSIX quirks ==="
(
	set -e
	echo "  step 1: succeeds"
	if false; then echo "  unreachable"; else echo "  step 2: if-condition failure ignored"; fi
	false && echo "  unreachable"
	echo "  step 3: non-last && failure ignored"
	! true
	echo "  step 4: negated pipeline (! true) ignored"
	{ false && echo "  unreachable"; }
	echo "  step 5: compound { ... } does not re-trigger errexit"
	false
	echo "  NEVER REACHED"
)
echo "  subshell exited on bare 'false' with status=$?"

echo ""
echo "=== 2. set -u (nounset) ==="
(
	set -u
	greeting="Ahoy"
	echo "  defined var: $greeting"
	echo "  default fallback: ${MISSING_SAILOR:-Captain Clam}"
	echo "  short-circuit arith: $((0 && MISSING_NUM))"
	echo "  now referencing unset var..."
	echo "$MISSING_SAILOR"
	echo "  NEVER REACHED"
) 2>&1 | sed 's/^/  /' || true

echo ""
echo "=== 3. set -o pipefail (POSIX.1-2024) ==="
(
	false | true
	echo "  without pipefail: false | true -> status=$?"
	set -o pipefail
	(exit 42) | true
	echo "  with pipefail:    (exit 42) | true -> status=$?"
	(exit 7) | (exit 19) | true
	echo "  rightmost non-zero: (exit 7) | (exit 19) | true -> status=$?"
)

echo ""
echo "=== 4. set -x (xtrace) with PS4 and LINENO ==="
(
	PS4='+[line $LINENO] '
	set -x
	dish="Clam Chowder"
	echo "Serving $dish" "Chef's special"
	set +x
) 2>&1 | sed 's/^/  /'

echo ""
echo "=== 5. set -C (noclobber) vs >| ==="
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
(
	set -C
	echo "original treasure" >"$tmp/chest.txt"
	echo "  created chest.txt: $(cat "$tmp/chest.txt")"
	echo "overwrite attempt" >"$tmp/chest.txt" 2>&1 | sed 's/^/  blocked: /' || true
	echo "  still intact: $(cat "$tmp/chest.txt")"
	echo "intentional update" >|"$tmp/chest.txt"
	echo "  after >| override: $(cat "$tmp/chest.txt")"
	echo "to /dev/null" >/dev/null
	echo "  non-regular /dev/null allowed: status=$?"
)

echo ""
echo "=== 6. set -o / set +o and \$- ==="
(
	set -e -u -C -o pipefail
	echo "  active flags (\$-): $-"
	echo "  set -o table:"
	set -o | sed 's/^/    /'
)
SCRIPT

echo ""
echo "=== 7. CLI -n (noexec syntax checker) ==="
if "$SH" -n -c 'echo "this will NOT run"; for x in a b; do echo "$x"; done'; then
	echo "  -n on valid script: syntax OK (nothing executed, status=0)"
fi
echo "  -n on broken script:"
"$SH" -n -c 'if true; then echo missing_fi' 2>&1 | sed 's/^/    /' || echo "  exit status=$?"
