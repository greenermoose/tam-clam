#!/bin/sh
# Interactive menu for tam-clam sandbox demos.
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
SH="$ROOT/build/tam-clam"

if [ ! -x "$SH" ]; then
	echo "Building tam-clam..."
	make -C "$ROOT"
fi

while :; do
	printf '\n=== tam-clam %s sandbox ===\n' "$(cat "$ROOT/VERSION")"
	printf '  1) 0.0.1 basics      (quoting, lists, builtins, refusals)\n'
	printf '  2) 0.0.2 pipes       (pipelines, !, &&/||, redirs, heredocs)\n'
	printf '  3) 0.0.3 vars        (variables, parameter expansion, $@/$*, tilde)\n'
	printf '  4) 0.0.3 cd          (logical -L, physical -P, cd -, CDPATH)\n'
	printf '  5) 0.0.4 control     (if, loops, case, {}, (), functions, FUNCNEST)\n'
	printf '  6) 0.1.0 expansions  ($'\''...'\'', $((...)), $(...), IFS, globbing)\n'
	printf '  7) 0.1.1 jobs/traps  (&, wait, $!, trap, set/shift/eval/./exec/times)\n'
	printf '  8) 0.1.2 builtins    (printf, echo, read, test/[, getopts, alias, type, ...)\n'
	printf '  9) 0.1.3 options     (set -e, -u, -o pipefail, -x/PS4/LINENO, -C, -n)\n'
	printf ' 10) 0.1.4 spec/fuzz   (POSIX spec table, fuzz mutations, self-dogfood)\n'
	printf ' 11) 0.1.5 lint mode   (tam-clam --lint FILE..., # lint: allow)\n'
	printf ' 12) 0.2.0 line editor (keys/keybindings.md, Ctrl+G/E, multi-line, bind)\n'
	printf ' 13) 0.2.1 history     (Up/Down prefix, Ctrl+F search, Alt+L, history)\n'
	printf ' 14) 0.2.2 job control (Ctrl+P pause, Ctrl+\\ break, jobs/fg/bg, %%n)\n'
	printf ' 15) 0.2.3 completion  (Tab/Shift+Tab: cmds, files, vars, users, .comp)\n'
	printf ' 16) 0.2.4 highlight   (live syntax highlighting & dimmed suggestions)\n'
	printf ' 17) 0.2.5 prompts     (PS1 escapes, RPS1 right prompt, precmd/preexec)\n'
	printf ' 18) 0.3.0 arrays      (indexed & associative arrays, beginner guide)\n'
	printf ' 19) interactive shell (try tam-clam live at a prompt)\n'
	printf '  q) quit\n'
	printf 'Choose [1-19, q]: '
	IFS= read -r choice || break
	printf '\n'
	case "$choice" in
	1) "$ROOT/sandbox/demo-0.0.1-basics" ;;
	2) "$ROOT/sandbox/demo-0.0.2-pipes" ;;
	3) "$ROOT/sandbox/demo-0.0.3-vars" ;;
	4) "$ROOT/sandbox/demo-0.0.3-cd" ;;
	5) "$ROOT/sandbox/demo-0.0.4-control" ;;
	6) "$ROOT/sandbox/demo-0.1.0-expansions" ;;
	7) "$ROOT/sandbox/demo-0.1.1-jobs-traps" ;;
	8) "$ROOT/sandbox/demo-0.1.2-builtins" ;;
	9) "$ROOT/sandbox/demo-0.1.3-options" ;;
	10) "$ROOT/sandbox/demo-0.1.4-spec-fuzz" ;;
	11) "$ROOT/sandbox/demo-0.1.5-lint" ;;
	12) "$ROOT/sandbox/demo-0.2.0-edit" ;;
	13) "$ROOT/sandbox/demo-0.2.1-history" ;;
	14) "$ROOT/sandbox/demo-0.2.2-jobs" ;;
	15) "$ROOT/sandbox/demo-0.2.3-complete" ;;
	16) "$ROOT/sandbox/demo-0.2.4-highlight" ;;
	17) "$ROOT/sandbox/demo-0.2.5-prompts" ;;
	18) "$ROOT/sandbox/demo-0.3.0-arrays" ;;
	19) "$ROOT/sandbox/demo-interactive" ;;
	q|Q) break ;;
	*) echo "Unknown choice: $choice" ;;
	esac
done
