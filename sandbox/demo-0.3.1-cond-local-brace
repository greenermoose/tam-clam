#!/bin/sh
# Sandbox demo for tam-clam 0.3.1: [[ ]], =~ with BASH_REMATCH, local/declare, and brace expansion.
set -e

BIN="${1:-./build/tam-clam}"

"$BIN" <<'EOF'
echo "=== 1. [[ ]] pattern matching, logic, and arithmetic ==="
ver="tam-clam-0.3.1"
if [[ $ver == tam-clam-* && ! ($ver == *.tmp) ]]; then
    echo "matched glob: $ver"
fi
a=10
b=25
if [[ a+15 -eq b && "alpha" < "beta" ]]; then
    echo "arithmetic & lexicographical ok"
fi

echo
echo "=== 2. [[ =~ ]] linear-time POSIX ERE & BASH_REMATCH ==="
line="2026-11-24 release 0.3.1"
if [[ $line =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})[[:space:]]+([a-z]+)[[:space:]]+([0-9.]+)$ ]]; then
    echo "full : ${BASH_REMATCH[0]}"
    echo "date : ${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
    echo "tag  : ${BASH_REMATCH[4]} ${BASH_REMATCH[5]}"
fi

echo
echo "=== 3. local and full declare (-i, -l, -u, -g, -F) ==="
x="outer"
demo_scope() {
    local x="inner"
    local -i count=2+3
    count+=10
    local -l low="MiXeD"
    local -u high="MiXeD"
    declare -g shared="from_func"
    echo "inside : x=$x count=$count low=$low high=$high"
}
demo_scope
echo "outside: x=$x shared=$shared"
echo -n "func   : "; declare -F demo_scope

echo
echo "=== 4. Brace expansion ==="
echo "comma  :" file.{c,h,o}
echo "nested :" {a,{b,c}}-{1,2}
echo "seq    :" {01..05} {e..a..2}
EOF
