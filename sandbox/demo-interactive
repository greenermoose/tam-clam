#!/bin/sh
# Launch an interactive tam-clam session with suggested things to try.
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
SH="$ROOT/build/tam-clam"
[ -x "$SH" ] || make -C "$ROOT"

cat <<EOF
Starting interactive tam-clam $(cat "$ROOT/VERSION") (type 'exit' or Ctrl-D to leave).
Things to try:
  PS1='clam> '                           # change the live prompt
  echo \$'\e[36m\U0001F41A hello!\e[0m'   # 0.1.0 ANSI-C + UTF-8
  echo \$((6 * 7))                        # 0.1.0 64-bit arithmetic
  echo src/*.c                           # 0.1.0 linear-time globbing
  for x in a b c; do echo "item: \$x"; done   # 0.0.4 loops
  (sleep 0.2; echo done) & wait \$!       # 0.1.1 background + wait
  trap 'echo bye!' EXIT                  # 0.1.1 EXIT trap
  set -- one two three; shift; echo "\$*" # 0.1.1 set + shift
  times                                  # 0.1.1 CPU times
  set -e                                 # see clear refusal of 0.1.3 option
EOF
exec env PS1='tam-clam$ ' PS2='tam-clam> ' "$SH"
